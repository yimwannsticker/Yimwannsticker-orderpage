# ===== Supabase (จำเป็น) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL จริงของเว็บ (ใช้สร้างลิงก์เช็คสถานะ และ LINE Login callback)
NEXT_PUBLIC_SITE_URL=https://order.yimwann.com

# สุ่มข้อความยาวๆ อย่างน้อย 32 ตัว (ใช้เซ็น cookie ของ LINE Login)
APP_SECRET=

# อีเมลที่ได้สิทธิ์แอดมินอัตโนมัติเมื่อล็อกอินครั้งแรก (คั่นด้วย ,)
ADMIN_EMAILS=yimwannsticker@gmail.com

# รหัสสำหรับ Vercel Cron (ลบไฟล์อัตโนมัติ)
CRON_SECRET=

# ===== อีเมลแจ้งเตือนร้าน (ไม่บังคับ) — Gmail + App Password ฟรี =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SHOP_NOTIFY_EMAIL=

# ===== LINE (ไม่บังคับ ต่อทีหลังได้) =====
# LINE Login channel (ผูกกับ LINE OA ของร้านเพื่อใช้ bot_prompt=aggressive)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Messaging API channel ของ LINE OA
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ===== ตรวจสลิปอัตโนมัติ (ไม่บังคับ ปิดไว้ในหน้าตั้งค่า) =====
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
EASYSLIP_API_KEY=
